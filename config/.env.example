# Gemini / Google AI Studio API Key (for LLM experiments)
GEMINI_API_KEY=

# Project Management Tools (Optional - when ready)
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_API_TOKEN=
# JIRA_USER_EMAIL=

# Communication / Collaboration (Optional - when ready)
# SLACK_BOT_TOKEN=
